<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vocahq.vocagateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPOSITORY__/.venv/bin/vocagateway</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/VocaGateway/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/VocaGateway/gateway-error.log</string>
</dict>
</plist>
